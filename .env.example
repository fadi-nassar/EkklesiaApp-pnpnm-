APP_ENV=development
PORT=3000

# used by docker-compose.yml to bootstrap the containers; the app itself only
# reads the full connection strings below
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=

MONGO_URI=mongodb://<MONGO_ROOT_USERNAME>:<MONGO_ROOT_PASSWORD>@localhost:27017/ekklesia?replicaSet=rs0&authSource=admin
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

# comma-separated list of allowed frontend origins; leave empty in production
# until a real frontend origin is known. Ignored (defaults to "*") when
# APP_ENV=development.
CORS_ORIGINS=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL=15m
REFRESH_TTL=30d

RESEND_API_KEY=
OTP_TTL=300

# set to true to skip the daily reminders job (no repeatable job, no worker)
DISABLE_REMINDERS=false
